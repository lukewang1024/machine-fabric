{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machine-fabric.dev/schemas/fabric.json",
  "type": "object",
  "required": ["apiVersion", "kind", "initiatorNode", "nodes", "topology"],
  "properties": {
    "apiVersion": {"const": "machine-fabric.dev/v1"},
    "kind": {"const": "Fabric"},
    "initiatorNode": {"$ref": "#/$defs/identity"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "topology": {
      "type": "object",
      "required": ["mode"],
      "properties": {"mode": {"const": "full-mesh"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {"type": "string", "pattern": "^[0-9A-Za-z._-]+$"},
    "node": {
      "type": "object",
      "required": ["id", "platform", "architecture", "allowRoots"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "platform": {"enum": ["macos", "linux", "windows"]},
        "architecture": {"enum": ["aarch64", "x86_64"]},
        "connection": {
          "type": "object",
          "required": ["sshAlias"],
          "properties": {"sshAlias": {"$ref": "#/$defs/identity"}},
          "additionalProperties": false
        },
        "allowRoots": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        }
      },
      "additionalProperties": false
    }
  }
}
